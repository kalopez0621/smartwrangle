# ============================================================
# SmartWrangle: local settings template
# ============================================================
# How to use:
#   1. Make a copy of this file in the same folder.
#   2. Name the copy exactly:  .env
#   3. Replace the placeholder below with your real key.
#
# The real .env file is listed in .gitignore, so it is never
# uploaded to GitHub. This example file has no real key and
# is safe to share.
#
# On Streamlit Community Cloud, put the same line in the app's
# Settings > Secrets box instead of using this file.
# ============================================================

ANTHROPIC_API_KEY=sk-ant-your-key-here
