# ============================================================
# SmartWrangle: secrets template for Google sign-in
# ============================================================
# How to use on your laptop:
#   1. Make a copy of this file in the same .streamlit folder.
#   2. Name the copy exactly:  secrets.toml
#   3. Replace each "paste-..." value with your real value.
#
# The real secrets.toml is listed in .gitignore, so it is never
# uploaded to GitHub. This example file has no real values and
# is safe to share.
#
# On Streamlit Community Cloud, paste the same [auth] section
# into the app's Settings > Secrets box, but change redirect_uri
# to the live address shown in the comment below.
# ============================================================

[auth]
# Where Google sends the person back after they sign in.
#   Laptop:          http://localhost:8501/oauth2callback
#   Streamlit Cloud: https://smartwrangle.streamlit.app/oauth2callback
# It must match a redirect URI saved in Google Cloud exactly.
redirect_uri = "http://localhost:8501/oauth2callback"

# A long random string that protects the sign-in cookie.
# Make one by running this in the terminal, then paste the result:
#   python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "paste-a-long-random-string-here"

# From Google Cloud > Google Auth Platform > Clients.
client_id = "paste-your-client-id-here"
client_secret = "paste-your-client-secret-here"

# Google's public sign-in settings address. Same for every app.
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
